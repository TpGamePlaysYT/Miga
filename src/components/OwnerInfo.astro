---
import siteInfo from '../config/site.json';
---

{siteInfo.ownerName && (
  <p>
    <strong>Responsable:</strong> {siteInfo.ownerName}
    {siteInfo.contactEmail && (
      <>
        {' '}
        · <a href={`mailto:${siteInfo.contactEmail}`}>{siteInfo.contactEmail}</a>
      </>
    )}
  </p>
)}
{siteInfo.hostingProvider && (
  <p>
    <strong>Alojamiento:</strong> {siteInfo.hostingProvider}.{' '}
    {siteInfo.logRetention && <>Conservación de registros: {siteInfo.logRetention}.</>}
  </p>
)}
{siteInfo.jurisdiction && (
  <p>
    <strong>Ámbito del responsable:</strong> {siteInfo.jurisdiction}.
  </p>
)}
{!siteInfo.ownerName && (
  <p>
    Antes del lanzamiento público, el responsable debe completar su identidad, contacto, proveedor
    de alojamiento, política de conservación y jurisdicción.
  </p>
)}
