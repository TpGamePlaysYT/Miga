---
import { sitePath } from '../lib/paths.js';
import Layout from '../layouts/Layout.astro';
---

<Layout title="Esta miga se nos ha escapado | Miga" noindex={true}>
  <section class="container not-found">
    <span class="empty-symbol" aria-hidden="true">
      ✳︎
    </span>
    <p class="eyebrow">ERROR 404</p>
    <h1>Esta miga se nos ha escapado.</h1>
    <p>La ficha no existe o todavía no está publicada. Hay más ideas por descubrir.</p>
    <a class="button dark" href={sitePath('/')}>
      Volver al inicio ↗
    </a>
  </section>
</Layout>
