---
import { sitePath } from '../lib/paths.js';
import Layout from './Layout.astro';
const { title, description, eyebrow = 'UN POCO MÁS SOBRE MIGA' } = Astro.props;
---

<Layout title={`${title} | Miga`} description={description}>
  <article class="info-page container">
    <span class="eyebrow">{eyebrow}</span>
    <h1>{title}</h1>
    <p class="info-lead">{description}</p>
    <div class="prose">
      <slot />
    </div>
    <a class="button dark" href={sitePath('/#explorar')}>
      Volver a explorar <span aria-hidden="true">↗</span>
    </a>
  </article>
</Layout>
